# Server binding
HOST=127.0.0.1
PORT=8765

# Optional: override SQLite database location
# BRUNO_DB_PATH=data/bruno.db

# Optional: protect /api/* when exposing publicly via Cloudflare Tunnel / Render / Funnel
# BRUNO_ACCESS_TOKEN=

# LLM Provider: auto | gemini | openai | anthropic | ollama | demo
LLM_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b

# Telephony Provider: simulation | vapi | retell | twilio_realtime
TELEPHONY_PROVIDER=simulation
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=
RETELL_API_KEY=
RETELL_FROM_NUMBER=
RETELL_AGENT_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Public HTTPS base URL for webhooks (e.g. Tailscale Funnel URL)
PUBLIC_BASE_URL=https://bruno-sony.tail617e7a.ts.net
